GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ADVANCED_MODEL=gemini-3.6-flash
SECRET_KEY=replace-with-a-long-random-secret

# Dataset storage: local for development, s3 in ECS/Fargate
DATASET_STORAGE_BACKEND=local
AWS_REGION=us-west-2
S3_DATASET_BUCKET=
S3_DATASET_PREFIX=datasets
DATASET_CACHE_DIR=uploads/.cache
MAX_UPLOAD_BYTES=52428800

# RDS/ECS can supply these instead of DATABASE_URL
DB_HOST=
DB_PORT=5432
DB_NAME=aistora
DB_USER=aistora
DB_PASSWORD=
DB_SSLMODE=require

# Optional agent budgets
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_OUTPUT_ROWS=25
AGENT_MAX_MATERIALIZED_ROWS=25000
AGENT_MAX_GROUPS=500
AGENT_TIMEOUT_SECONDS=45
AGENT_MODEL_ROUTING=true
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BASE_SECONDS=0.5
AGENT_HISTORY_EXAMPLES=3
CLEANING_MAX_ROWS=250000
