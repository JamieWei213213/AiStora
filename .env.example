# development | production. Production refuses to start without SECRET_KEY
# and defaults SESSION_COOKIE_SECURE to true.
APP_ENV=development

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ADVANCED_MODEL=gemini-3.6-flash
SECRET_KEY=replace-with-a-long-random-secret
# Keep false for localhost; set true when the site is served only over HTTPS.
# In production this defaults to true and must be explicitly disabled if the
# load balancer still terminates plain HTTP.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12

# Server-side session storage. Set REDIS_URL in any deployment with more than
# one process; without it sessions fall back to a per-container filesystem
# store and users are logged out as requests move between containers.
REDIS_URL=
SESSION_FILE_DIR=instance/sessions

# Dataset storage: local for development, s3 in ECS/Fargate
DATASET_STORAGE_BACKEND=local
AWS_REGION=us-west-2
S3_DATASET_BUCKET=
S3_DATASET_PREFIX=datasets
DATASET_CACHE_DIR=uploads/.cache
MAX_UPLOAD_BYTES=52428800

# RDS/ECS can supply these instead of DATABASE_URL
DB_HOST=
DB_PORT=5432
DB_NAME=aistora
DB_USER=aistora
DB_PASSWORD=
DB_SSLMODE=require

# Optional agent budgets
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_OUTPUT_ROWS=25
AGENT_MAX_MATERIALIZED_ROWS=25000
AGENT_MAX_GROUPS=500
AGENT_TIMEOUT_SECONDS=45
AGENT_MODEL_ROUTING=true
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BASE_SECONDS=0.5
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_OUTPUT_TOKENS=2048
AGENT_HISTORY_EXAMPLES=3
AGENT_SCHEMA_PRIVACY=classified
# full: the data owner sees their own rows (default).
# masked: sensitive columns are redacted in the browser too (shared screens).
# aggregate_only: no rows are rendered at all.
# This does NOT affect what the model sees; AGENT_SCHEMA_PRIVACY governs that.
AGENT_RESULT_PRIVACY=full
AGENT_MAX_CORRECTIONS=3
AGENT_MAX_QUERY_CHARS=4000
AGENT_RATE_LIMIT_PER_MINUTE=20
RELATIONSHIP_RATE_LIMIT_PER_MINUTE=5
# Daily spend guardrails, reset at midnight UTC. 0 disables a ceiling.
# At Flash-Lite prices 400k tokens is well under $1 per user per day; the
# global ceiling caps the whole deployment regardless of how many accounts
# someone registers.
AGENT_DAILY_REQUESTS_PER_USER=150
AGENT_DAILY_TOKENS_PER_USER=400000
AGENT_DAILY_TOKENS_GLOBAL=4000000
# Upload shape limits. Column names go into every model prompt.
MAX_UPLOAD_COLUMNS=200
MAX_COLUMN_NAME_CHARS=64
MAX_TABLES_PER_PROJECT=20
MAX_PROJECTS_PER_USER=10
# Set current provider prices to enable estimated cost reporting.
AGENT_INPUT_COST_PER_MILLION=0
AGENT_OUTPUT_COST_PER_MILLION=0
CLEANING_MAX_ROWS=250000
# Rows sampled for CSV type inference. Raise for wide exports whose first
# rows are not representative.
CSV_TYPE_SAMPLE_ROWS=1000

# Deterministic local EDA report budgets
EDA_MAX_TABLES=20
EDA_MAX_COLUMNS_PER_TABLE=60
EDA_MAX_ROWS_PER_TABLE=100000
EDA_MAX_NUMERIC_COLUMNS=25
EDA_MAX_CATEGORICAL_COLUMNS=25
EDA_MAX_CORRELATION_COLUMNS=12
EDA_MAX_TOP_CATEGORIES=5
EDA_MAX_DISTINCT_VALUES=25000
EDA_MAX_DUPLICATE_ROWS=100000
EDA_MAX_CATEGORY_TRACKED_VALUES=1000
EDA_MIN_OUTLIER_SAMPLE_SIZE=30
EDA_TIMEOUT_SECONDS=30
EDA_RATE_LIMIT_PER_MINUTE=3
