# Python virtual environment
venv/
.venv/
.venv-win/
.tools/

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.pytest-tmp-*/
.coverage
htmlcov/

# OS-specific files
.DS_Store

# Uploaded data files (ignore all content in uploads, *except* the .gitkeep)
uploads/*
!uploads/.gitkeep
instance/agent_audit.jsonl
instance/agent_cancellations/
instance/sessions/
instance/*.db

# Terraform runtime and sensitive local configuration
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
backend.hcl
crash.log
crash.*.log

# Secrets and environment variables
.env
.env.*
!.env.example

# Credential files. The previous rule was a bare `*.json`, which also ignored
# legitimate JSON that belongs in the repository and hid it silently.
aws-credentials*.json
*service-account*.json
*credentials*.json
!tests/fixtures/*.json
node_modules/

# Source archives and local scratch
*.tgz
*.zip
