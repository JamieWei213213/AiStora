aws_region        = "us-west-2"
project_name      = "aistora"
environment       = "dev"
github_repository = "JamieWei213213/AiStora"

# Tag of the pipeline image to run. Push one first (Pipeline workflow ->
# "Run workflow"), then apply with the tag it printed.
image_tag = "bootstrap"

# Name of the GitHub Actions role created by infra/terraform, so the same
# role can push the pipeline image and update the function.
github_deploy_role_name = "aistora-dev-github-deploy"

# Alarm notifications. Null keeps the topic without a subscription.
alarm_email = null

# Scheduled connector runs: connector_id => Scheduler expression.
connector_schedules = {}

lake_force_destroy          = false
lambda_memory_mb            = 1769
lambda_reserved_concurrency = -1
log_retention_days          = 30
